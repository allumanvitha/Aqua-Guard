<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b1218"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_profile_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Profile"
        android:textColor="#2196f3"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <!-- Avatar Placeholder -->
    <TextView
        android:id="@+id/tv_avatar_placeholder"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/circle_bg_status"
        android:backgroundTint="#2196f3"
        android:textColor="#ffffff"
        android:text="A"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_profile_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- User Display Name -->
    <TextView
        android:id="@+id/tv_profile_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aqua Guard User"
        android:textColor="#ffffff"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_avatar_placeholder"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- User Email -->
    <TextView
        android:id="@+id/tv_profile_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="user@aquaguard.com"
        android:textColor="#80ffffff"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_profile_name"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Form Section Header -->
    <TextView
        android:id="@+id/tv_household_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Household Configuration"
        android:textColor="#ffffff"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_profile_email"
        app:layout_constraintLeft_toLeftOf="parent" />

    <!-- Family Members Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_family_members"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Number of Family Members"
        android:textColorHint="#80ffffff"
        app:boxStrokeColor="#2196f3"
        app:hintTextColor="#2196f3"
        app:boxStrokeWidth="2dp"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_household_header">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_family_members"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ffffff"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Daily Target Liters Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_daily_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Daily Water Target (Liters)"
        android:textColorHint="#80ffffff"
        app:boxStrokeColor="#2196f3"
        app:hintTextColor="#2196f3"
        app:boxStrokeWidth="2dp"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/til_family_members">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_daily_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ffffff"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Save Changes Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_profile"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Save Changes"
        android:textColor="#ffffff"
        android:backgroundTint="#2196f3"
        android:textSize="14sp"
        app:cornerRadius="10dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/til_daily_target" />

    <!-- Settings Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settings"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="App Settings"
        android:textColor="#ffffff"
        app:strokeColor="#1fffffff"
        app:strokeWidth="1dp"
        android:textSize="14sp"
        app:cornerRadius="10dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btn_save_profile" />

    <!-- Sign Out Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sign_out"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Sign Out"
        android:textColor="#f44336"
        android:textSize="14sp"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
