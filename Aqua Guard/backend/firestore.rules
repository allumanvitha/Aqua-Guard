rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection: Users can only read/write their own profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Devices Collection: Only authenticated users can register devices, and only the owner can read/write
    match /devices/{deviceId} {
      allow read, update, delete: if isAuthenticated() && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
    }

    // Water Usage Collection: Owner of the device can read/write usage data
    match /water_usage/{usageId} {
      allow read, write: if isAuthenticated();
    }

    // Alerts Collection: Owner can read/update alerts
    match /alerts/{alertId} {
      allow read, update, create: if isAuthenticated();
    }

    // Valve Logs Collection: Owner can read/create valve logs
    match /valve_logs/{logId} {
      allow read, create: if isAuthenticated();
    }
  }
}
