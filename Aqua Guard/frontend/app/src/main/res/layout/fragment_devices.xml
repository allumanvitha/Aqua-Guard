<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b1218"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_devices_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Device Management"
        android:textColor="#2196f3"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#2196f3"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/tv_devices_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_devices_title"
        app:layout_constraintRight_toRightOf="parent" />

    <ImageView
        android:id="@+id/iv_add_new_device"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_menu_add"
        app:tint="#2196f3"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/tv_devices_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_devices_title"
        app:layout_constraintRight_toLeftOf="@id/iv_back" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_devices_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/tv_devices_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:listitem="@layout/item_device" />

    <LinearLayout
        android:id="@+id/ll_empty_devices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_devices_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡"
            android:textSize="50sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Connected Devices"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register your Aqua Guard hardware device to start monitoring water usage."
            android:textColor="#80ffffff"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_device_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Aqua Guard Device"
            android:textColor="#ffffff"
            android:backgroundTint="#2196f3"
            android:layout_marginTop="20dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
